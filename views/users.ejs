<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Users</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; display: flex; min-height: 100vh; }

    /* Sidebar */
    .sidebar {
      width: 240px;
      background: #1a1a2e;
      color: #fff;
      padding: 20px 0;
      flex-shrink: 0;
    }
    .sidebar h2 {
      text-align: center;
      margin-bottom: 30px;
      font-size: 1.2rem;
    }
    .sidebar nav a {
      display: block;
      padding: 12px 24px;
      color: #ccc;
      text-decoration: none;
      transition: background 0.2s;
    }
    .sidebar nav a:hover,
    .sidebar nav a.active {
      background: #16213e;
      color: #fff;
    }

    /* Main content */
    .main {
      flex: 1;
      padding: 30px;
      background: #f4f4f8;
    }
    .main h1 {
      margin-bottom: 20px;
      color: #333;
    }

    /* Add user form */
    .add-user-form {
      background: #fff;
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
      margin-bottom: 30px;
      display: flex;
      gap: 12px;
      align-items: flex-end;
    }
    .add-user-form .field {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .add-user-form label {
      font-size: 0.8rem;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .add-user-form input {
      padding: 8px 12px;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 0.95rem;
      width: 220px;
    }
    .add-user-form input:focus {
      outline: none;
      border-color: #1a1a2e;
    }
    .add-user-form button {
      padding: 8px 20px;
      background: #1a1a2e;
      color: #fff;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.95rem;
      transition: background 0.2s;
    }
    .add-user-form button:hover { background: #16213e; }

    /* Message */
    .message {
      padding: 10px 16px;
      border-radius: 6px;
      margin-bottom: 20px;
      font-size: 0.9rem;
    }
    .message.success { background: #d4edda; color: #155724; }
    .message.error { background: #f8d7da; color: #721c24; }

    /* Table */
    table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }
    th, td {
      padding: 12px 16px;
      text-align: left;
      border-bottom: 1px solid #eee;
    }
    th { background: #1a1a2e; color: #fff; }
    tr:last-child td { border-bottom: none; }
    .empty-row td { text-align: center; color: #999; }
  </style>
</head>
<body>

  <!-- Sidebar Navigation -->
  <aside class="sidebar">
    <h2>Greeting Tool</h2>
    <nav>
      <a href="/dashboard">Dashboard</a>
      <a href="/analytics">Analytics</a>
      <a href="/users" class="active">Users</a>
      <a href="#">Settings</a>
      <a href="#">Help</a>
    </nav>
  </aside>

  <!-- Main Content Area -->
  <main class="main">
    <h1>Users (<%= users.length %>)</h1>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="message <%= messageType %>"><%= message %></div>
    <% } %>

    <form class="add-user-form" method="POST" action="/users">
      <div class="field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" placeholder="Jane Doe" required>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="jane@example.com" required>
      </div>
      <button type="submit">Add User</button>
    </form>

    <table>
      <thead>
        <tr><th>ID</th><th>Name</th><th>Email</th><th>Created</th></tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr class="empty-row"><td colspan="4">No users yet.</td></tr>
        <% } else { %>
          <% users.forEach(user => { %>
            <tr>
              <td><%= user.id %></td>
              <td><%= user.name %></td>
              <td><%= user.email %></td>
              <td><%= user.created_at %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </main>

</body>
</html>
